{
  "family": "fragments-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::637423452839:role/LabRole",
  "taskRoleArn": "arn:aws:iam::637423452839:role/LabRole",
  "containerDefinitions": [
    {
      "name": "fragments-container",
      "image": "averma112/fragments:latest",
      "essential": true,
      "cpu": 256,
      "memory": 512,
      "memoryReservation": 512,
      "environment": [],
      "environmentFiles": [],
      "mountPoints": [],
      "portMappings": [
        {
          "appProtocol": "http",
          "containerPort": 80,
          "hostPort": 80,
          "name": "fragments-container-80-tcp",
          "protocol": "tcp"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/fragments-task",
          "awslogs-create-group": "true",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        },
        "secretOptions": []
      },
      "systemControls": [],
      "ulimits": [],
      "volumesFrom": []
    }
  ],
  "volumes": []
}
